nks-Regulations-2021.pdf", year_of_issue:2021, status:"active"}}, {regulation_version_id:"Reg_85_2005", properties:{regulation_id:"Reg_85", uri:"//nafdac.gov.ng/ontology/regulation/Reg_85_2005", year_of_issue:2005, status:"revoked"}}, {regulation_version_id:"Reg_69_2021", properties:{regulation_id:"Reg_69", effective_date:"2021-07-07", uri:"//nafdac.gov.ng/ontology/regulation/Food-Irradiation-Regulations-2021.pdf", year_of_issue:2021, status:"active"}}, {regulation_version_id:"Reg_68_2021", properties:{regulation_id:"Reg_68", effective_date:"2021-07-07", uri:"//nafdac.gov.ng/ontology/regulation/Food-Grade-Salt-Regulations-2021.pdf", year_of_issue:2021, status:"active"}}, {regulation_version_id:"Reg_27_2022", properties:{regulation_id:"Reg_27", effective_date:"2022-11-18", uri:"//nafdac.gov.ng/ontology/regulation/Pre-Packaged-Food-Labelling-Regulations-2022.pdf", year_of_issue:2022, status:"active"}}, {regulation_version_id:"Reg_26_2022", properties:{regulation_id:"Reg_26", effective_date:"2022-11-18", uri:"//nafdac.gov.ng/ontology/regulation/Fats-Oils-Foods-Regulations-2022.pdf", year_of_issue:2022, status:"active"}}, {regulation_version_id:"Reg_67_2021", properties:{regulation_id:"Reg_67", effective_date:"2021-07-07", uri:"//nafdac.gov.ng/ontology/regulation/FOOD-FORTIFICATION-REGULATIONS-2021.pdf", year_of_issue:2021, status:"active"}}, {regulation_version_id:"Reg_56_2021", properties:{regulation_id:"Reg_56", effective_date:"2021-07-07", uri:"//nafdac.gov.ng/ontology/regulation/Spirits-Drink-Regulations-2021.pdf", year_of_issue:2021, status:"active"}}, {regulation_version_id:"Reg_57_2021", properties:{regulation_id:"Reg_57", effective_date:"2021-07-07", uri:"//nafdac.gov.ng/ontology/regulation/Wine-Regulations-2021.pdf", year_of_issue:2021, status:"active"}}] AS row
