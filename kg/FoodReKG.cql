CREATE CONSTRAINT UNIQUE_IMPORT_NAME FOR (node:`UNIQUE IMPORT LABEL`) REQUIRE (node.`UNIQUE IMPORT ID`) IS UNIQUE;
CREATE CONSTRAINT actor_name_unique FOR (node:Actor) REQUIRE (node.name) IS UNIQUE;
CREATE CONSTRAINT clause_id_unique FOR (node:Clause) REQUIRE (node.clause_id) IS UNIQUE;
CREATE CONSTRAINT concept_unique FOR (node:Concept) REQUIRE (node.name, node.uri) IS UNIQUE;
CREATE CONSTRAINT defined_term_unique FOR (node:DefinedTerm) REQUIRE (node.term_id) IS UNIQUE;
CREATE CONSTRAINT issuing_authority_unique FOR (node:IssuingAuthority) REQUIRE (node.authority_id) IS UNIQUE;
CREATE CONSTRAINT label_artifact_unique FOR (node:LabelArtifact) REQUIRE (node.label_id) IS UNIQUE;
CREATE CONSTRAINT legal_reference_unique FOR (node:LegalReference) REQUIRE (node.name) IS UNIQUE;
CREATE CONSTRAINT outcome_id_unique FOR (node:Outcome) REQUIRE (node.outcome_id) IS UNIQUE;
CREATE CONSTRAINT publication_unique FOR (node:Publication) REQUIRE (node.gazette_no, node.notice_no) IS UNIQUE;
CREATE CONSTRAINT regulation_id_unique FOR (node:Regulation) REQUIRE (node.regulation_id) IS UNIQUE;
CREATE CONSTRAINT regulation_version_id_unique FOR (node:RegulationVersion) REQUIRE (node.regulation_version_id) IS UNIQUE;
CREATE CONSTRAINT schedule_id_unique FOR (node:Schedule) REQUIRE (node.schedule_id) IS UNIQUE;
CREATE CONSTRAINT schedule_item_id_unique FOR (node:ScheduleItem) REQUIRE (node.schedule_item_id) IS UNIQUE;
CREATE CONSTRAINT UNIQUE_IMPORT_NAME FOR (node:`UNIQUE IMPORT LABEL`) REQUIRE (node.`UNIQUE IMPORT ID`) IS UNIQUE;
