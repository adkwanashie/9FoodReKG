:"Fine_800k_Reg27", properties:{amount:"₦800,000", max_term:"1 year", type:"Fine", uri:"//nafdac.gov.ng/ontology/outcome/Fine_800k_Reg27"}}, {outcome_id:"Fine_5m_Reg27", properties:{amount:"₦5,000,000", type:"Fine", uri:"//nafdac.gov.ng/ontology/outcome/Fine_5m_Reg27"}}, {outcome_id:"Fine_800k_Reg26", properties:{amount:"₦800,000", max_term:"1 year", type:"Fine", uri:"//nafdac.gov.ng/ontology/outcome/Fine_800k_Reg26"}}, {outcome_id:"Fine_5m_Reg26", properties:{amount:"₦5,000,000", type:"Fine", uri:"//nafdac.gov.ng/ontology/outcome/Fine_5m_Reg26"}}, {outcome_id:"Fine_800k_Reg56", properties:{amount:"₦800,000", max_term:"1 year", type:"Fine", uri:"//nafdac.gov.ng/ontology/outcome/Fine_800k_Reg56"}}, {outcome_id:"Fine_5m_Reg56", properties:{amount:"₦5,000,000", type:"Fine", uri:"//nafdac.gov.ng/ontology/outcome/Fine_5m_Reg56"}}, {outcome_id:"Fine_800k_Reg57", properties:{amount:"₦800,000", max_term:"1 year", type:"Fine", uri:"//nafdac.gov.ng/ontology/outcome/Fine_800k_Reg57"}}, {outcome_id:"Fine_5m_Reg57", properties:{amount:"₦5,000,000", type:"Fine", uri:"//nafdac.gov.ng/ontology/outcome/Fine_5m_Reg57"}}] AS row
