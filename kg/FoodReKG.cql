perties:{volume:"108", publication_date:"2021-07-12", printer_ref:"FGP 176/092021/150", uri:"//nafdac.gov.ng/ontology/publication/No_113", si_no:"56"}}, {gazette_no:"114", notice_no:"102", properties:{volume:"108", publication_date:"2021-07-13", printer_ref:"FGP 177/092021/150", uri:"//nafdac.gov.ng/ontology/publication/No_114", si_no:"57"}}] AS row
