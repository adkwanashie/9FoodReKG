UNWIND [{clause_id:"Reg_70_C2", properties:{clause_text:"A person shall not advertise a food product unless it has been registered by the Agency.", regulation_version_id:"Reg_70_2021", clause_number:"2", uri:"//nafdac.gov.ng/ontology/clause/70/2"}}, {clause_id:"Reg_71_C3", properties:{clause_text:"Fruit juice shall contain not less than 85% fruit content.", regulation_version_id:"Reg_71_2021", clause_number:"3", uri:"//nafdac.gov.ng/ontology/clause/71/3"}}, {clause_id:"Reg_80_C3", properties:{clause_text:"Milk and dairy products shall be labeled to declare the animal source (cow, goat, etc.).", regulation_version_id:"Reg_80_2021", clause_number:"3", uri:"//nafdac.gov.ng/ontology/clause/80/3"}}, {clause_id:"Reg_82_C4", properties:{clause_text:"Only permitted non-nutritive sweeteners listed in Schedule I may be used in food products.", regulation_version_id:"Reg_82_2021", clause_number:"4", uri:"//nafdac.gov.ng/ontology/clause/82/4"}}, {clause_id:"Reg_85_C2", properties:{clause_text:"Soft drinks shall not contain non-nutritive sweeteners except as permitted in Regulation 82.", regulation_version_id:"Reg_85_2021", clause_number:"2", uri:"//nafdac.gov.ng/ontology/clause/85/2"}}, {clause_id:"Reg_69_C1", properties:{clause_text:"Scope of application: applies to foods processed by ionizing radiation.", regulation_version_id:"Reg_69_2021", clause_number:"1", uri:"//nafdac.gov.ng/ontology/clause/69/1"}}, {clause_id:"Reg_69_C16", properties:{clause_text:"Offences and Penalties: Individuals liable to ₦800,000 fine or ≤1 year imprisonment; corporates liable to ₦5,000,000 fine.", regulation_version_id:"Reg_69_2021", clause_number:"16", uri:"//nafdac.gov.ng/ontology/clause/69/16"}}, {clause_id:"Reg_68_C1", properties:{clause_text:"Scope of application: applies to salt used as an ingredient of food for direct use by consumers and for food manufacture.", regulation_version_id:"Reg_68_2021", clause_number:"1", uri:"//nafdac.gov.ng/ontology/clause/68/1"}}, {clause_id:"Reg_68_C11", properties:{clause_text:"Offences and Penalties: Individuals liable to ₦800,000 fine or ≤1 year imprisonment; corporates liable to ₦5,000,000 fine.", regulation_version_id:"Reg_68_2021", clause_number:"11", uri:"//nafdac.gov.ng/ontology/clause/68/11"}}, {clause_id:"Reg_27_C1", properties:{clause_text:"Scope of application: applies to labelling of pre-packaged food manufactured, imported, exported, sold, distributed or used in Nigeria.", regulation_version_id:"Reg_27_2022", clause_number:"1", uri:"//nafdac.gov.ng/ontology/clause/27/1"}}, {clause_id:"Reg_27_C23", properties:{clause_text:"Offences and Penalties: Individuals liable to ₦800,000 fine or ≤1 year imprisonment; corporates liable to ₦5,000,000 fine.", regulation_version_id:"Reg_27_2022", clause_number:"23", uri:"//nafdac.gov.ng/ontology/clause/27/23"}}, {clause_id:"Reg_26_C1", properties:{clause_text:"Scope of application: applies to edible fats, oils and foods containing fats and oils manufactured, imported, exported, advertised, sold, distributed, used or consumed in Nigeria.", regulation_version_id:"Reg_26_2022", clause_number:"1", uri:"//nafdac.gov.ng/ontology/clause/26/1"}}, {clause_id:"Reg_26_C2", properties:{clause_text:"Edible fats and oils shall be sourced from vegetable and animal origin, certified fit for human consumption, and named as indicated in the First Schedule.", regulation_version_id:"Reg_26_2022", clause_number:"2", uri:"//nafdac.gov.ng/ontology/clause/26/2"}}, {clause_id:"Reg_26_C3", properties:{clause_text:"Vegetable oils specified in the First Schedule must be fortified with Vitamin A of not below 20,000 IU/kg.", regulation_version_id:"Reg_26_2022", clause_number:"3", uri:"//nafdac.gov.ng/ontology/clause/26/3"}}, {clause_id:"Reg_26_C4", properties:{clause_text:"Edible fats and oils may contain permitted colours, flavours, preservatives, anti-foaming agents and crystallization inhibitors, subject to limits prescribed in the Seventeenth Schedule.", regulation_version_id:"Reg_26_2022", clause_number:"4", uri:"//nafdac.gov.ng/ontology/clause/26/4"}}, {clause_id:"Reg_26_C5", properties:{clause_text:"Edible fats and oils shall not contain impurities such as heavy metals, petroleum products, foreign particles, inedible oils, dyes, or rancid odour/taste.", regulation_version_id:"Reg_26_2022", clause_number:"5", uri:"//nafdac.gov.ng/ontology/clause/26/5"}}, {clause_id:"Reg_26_C6", properties:{clause_text:"Labelling must comply with Pre-Packaged Food (Labelling) Regulations and declare refined oils, blends, margarine, and mixtures of animal/vegetable fats appropriately.", regulation_version_id:"Reg_26_2022", clause_number:"6", uri:"//nafdac.gov.ng/ontology/clause/26/6"}}, {clause_id:"Reg_26_C7", properties:{clause_text:"Trans-fat content exceeding 2g per 100g of fat or oil is prohibited. Claims of trans-fat or cholesterol free must be verified and approved by NAFDAC.", regulation_version_id:"Reg_26_2022", clause_number:"7", uri:"//nafdac.gov.ng/ontology/clause/26/7"}}, {clause_id:"Reg_26_C10", properties:{clause_text:"Offences and Penalties: Individuals liable to ₦800,000 fine or ≤1 year imprisonment; corporates liable to ₦5,000,000 fine.", regulation_version_id:"Reg_26_2022", clause_number:"10", uri:"//nafdac.gov.ng/ontology/clause/26/10"}}, {clause_id:"Reg_56_C1", properties:{clause_text:"Scope of application: applies to all Spirits drinks manufactured, imported, exported, distributed, advertised, sold or used in Nigeria; and to the use of ethyl alcohol and distillates of agricultural origin in alcoholic beverages.", regulation_version_id:"Reg_56_2021", clause_number:"1", uri:"//nafdac.gov.ng/ontology/clause/56/1"}}, {clause_id:"Reg_56_C2", properties:{clause_text:"No person shall manufacture, import, export, advertise, display for sale, offer for sale, sell, distribute or use Spirits drink specified in First Schedule unless registered in accordance with these Regulations.", regulation_version_id:"Reg_56_2021", clause_number:"2", uri:"//nafdac.gov.ng/ontology/clause/56/2"}}, {clause_id:"Reg_56_C3", properties:{clause_text:"The use and limits of food additives, ethyl carbamate, contaminants or food colours in the manufacture of Spirits drinks shall be specified in the Third, Fourth and Fifth Schedules or as prescribed by the Agency.", regulation_version_id:"Reg_56_2021", clause_number:"3", uri:"//nafdac.gov.ng/ontology/clause/56/3"}}, {clause_id:"Reg_56_C4", properties:{clause_text:"Spirits drinks shall not contain caffeine or other substances injurious to health; names under which Spirits drinks are sold shall comply with these Regulations.", regulation_version_id:"Reg_56_2021", clause_number:"4", uri:"//nafdac.gov.ng/ontology/clause/56/4"}}, {clause_id:"Reg_56_C5", properties:{clause_text:"Labels must protect geographical indications; packaging in PET bottles, sachets or foils as prescribed; age restriction '18+' displayed; health claims prohibited.", regulation_version_id:"Reg_56_2021", clause_number:"5", uri:"//nafdac.gov.ng/ontology/clause/56/5"}}, {clause_id:"Reg_56_C6", properties:{clause_text:"Advertisements must not be misleading or contain health claims; prohibited in children's programs; children, sportsmen or expectant mothers must not be used as models; '18+' restriction displayed.", regulation_version_id:"Reg_56_2021", clause_number:"6", uri:"//nafdac.gov.ng/ontology/clause/56/6"}}, {clause_id:"Reg_56_C7", properties:{clause_text:"Spirits drinks shall conform to specifications provided in the Second Schedule.", regulation_version_id:"Reg_56_2021", clause_number:"7", uri:"//nafdac.gov.ng/ontology/clause/56/7"}}, {clause_id:"Reg_56_C8", properties:{clause_text:"Where an indigenous company or agent is franchised to distill in Nigeria, the distilled Spirits drinks shall be described by their original name in the country of origin.", regulation_version_id:"Reg_56_2021", clause_number:"8", uri:"//nafdac.gov.ng/ontology/clause/56/8"}}, {clause_id:"Reg_56_C9", properties:{clause_text:"Individuals liable to imprisonment ≤1 year or fine ≤₦800,000 or both; corporates liable to fine ≤₦5,000,000.", regulation_version_id:"Reg_56_2021", clause_number:"9", uri:"//nafdac.gov.ng/ontology/clause/56/9"}}, {clause_id:"Reg_56_C10", properties:{clause_text:"Convicted persons shall forfeit assets or property derived from the offence and instrumentalities used to commit the offence.", regulation_version_id:"Reg_56_2021", clause_number:"10", uri:"//nafdac.gov.ng/ontology/clause/56/10"}}, {clause_id:"Reg_56_C11", properties:{clause_text:"The Spirits Drink Regulations, 2005 is revoked; actions under the revoked Regulations remain valid.", regulation_version_id:"Reg_56_2021", clause_number:"11", uri:"//nafdac.gov.ng/ontology/clause/56/11"}}, {clause_id:"Reg_56_C12", properties:{clause_text:"The Agency shall be responsible for enforcement of these Regulations.", regulation_version_id:"Reg_56_2021", clause_number:"12", uri:"//nafdac.gov.ng/ontology/clause/56/12"}}, {clause_id:"Reg_56_C13", properties:{clause_text:"Definitions provided for Agency, Alcohol of agricultural origin, Blended spirit, Food, Geographical indication, Maturation, Proceeds, Spirit drink, etc.", regulation_version_id:"Reg_56_2021", clause_number:"13", uri:"//nafdac.gov.ng/ontology/clause/56/13"}}, {clause_id:"Reg_56_C14", properties:{clause_text:"These Regulations shall be cited as Spirits Drink Regulations, 2021.", regulation_version_id:"Reg_56_2021", clause_number:"14", uri:"//nafdac.gov.ng/ontology/clause/56/14"}}, {clause_id:"Reg_57_C1", properties:{clause_text:"These Regulations regulate and apply to wine manufactured, imported, exported, advertised, sold, distributed or used in Nigeria.", regulation_version_id:"Reg_57_2021", clause_number:"1", uri:"//nafdac.gov.ng/ontology/clause/57/1"}}, {clause_id:"Reg_57_C2", properties:{clause_text:"No person shall manufacture, import, export, advertise, sell, display for sale, offer for sale, or distribute wine specified in First Schedule unless registered under these Regulations.", regulation_version_id:"Reg_57_2021", clause_number:"2", uri:"//nafdac.gov.ng/ontology/clause/57/2"}}, {clause_id:"Reg_57_C3", properties:{clause_text:"The Agency shall approve use and limits of food additives or food colours in wine manufacture. Sulphites above 10ppm require label declaration.", regulation_version_id:"Reg_57_2021", clause_number:"3", uri:"//nafdac.gov.ng/ontology/clause/57/3"}}, {clause_id:"Reg_57_C4", properties:{clause_text:"Grape wine classified by vintage, variety, sugar content/sweetness. Produced exclusively from fermentation of fresh grapes or grape juice. Categories include table wine, ice wine, botrytized wine, late harvest wine, vin du curé, nouveau red wine, blanc de noirs, blanc de blanc, liqueur wine, fortified wine, sparkling wine, port wine, or as prescribed.", regulation_version_id:"Reg_57_2021", clause_number:"4", uri:"//nafdac.gov.ng/ontology/clause/57/4"}}, {clause_id:"Reg_57_C5", properties:{clause_text:"Varietal wines classified by crop year (except sparkling, fortified, liqueur). ≥85% grapes from same crop year. Sweet reserve included in calculation.", regulation_version_id:"Reg_57_2021", clause_number:"5", uri:"//nafdac.gov.ng/ontology/clause/57/5"}}, {clause_id:"Reg_57_C6", properties:{clause_text:"Wine produced from ≥75% of named varietal. If two varietals, wine must come entirely from them, listed in decreasing order, least ≥15%. Percentages declared on label.", regulation_version_id:"Reg_57_2021", clause_number:"6", uri:"//nafdac.gov.ng/ontology/clause/57/6"}}, {clause_id:"Reg_57_C7", properties:{clause_text:"Sweetness descriptors permitted on principal display panel with limits set in Second Schedule.", regulation_version_id:"Reg_57_2021", clause_number:"7", uri:"//nafdac.gov.ng/ontology/clause/57/7"}}, {clause_id:"Reg_57_C8", properties:{clause_text:"Wine may be designated single-vineyard if ≥85% grapes from designated vineyard; remainder ≤15% from same geographical location.", regulation_version_id:"Reg_57_2021", clause_number:"8", uri:"//nafdac.gov.ng/ontology/clause/57/8"}}, {clause_id:"Reg_57_C9", properties:{clause_text:"Labels must declare 'Best Before' if <10% alcohol; country of origin clearly indicated; blended/bottled/packed statements required; '18+' prominently displayed; health claims prohibited.", regulation_version_id:"Reg_57_2021", clause_number:"9", uri:"//nafdac.gov.ng/ontology/clause/57/9"}}, {clause_id:"Reg_57_C10", properties:{clause_text:"Name of wine must indicate accurate nature. Only established names used; otherwise appropriate descriptive name.", regulation_version_id:"Reg_57_2021", clause_number:"10", uri:"//nafdac.gov.ng/ontology/clause/57/10"}}, {clause_id:"Reg_57_C11", properties:{clause_text:"Terms like grand vin, cru, superior wine, classico, vino nobile allowed only if wine has recognized appellation/geographic indication, attributed by official body, and label shows vintage.", regulation_version_id:"Reg_57_2021", clause_number:"11", uri:"//nafdac.gov.ng/ontology/clause/57/11"}}, {clause_id:"Reg_57_C12", properties:{clause_text:"Wine advertisements must comply with Agency regulations; pre-cleared and approved; not misleading; no health claims; not permitted in children's programmes; children, sportsmen, expectant mothers not used as models; gift items not directed at children/sportsmen.", regulation_version_id:"Reg_57_2021", clause_number:"12", uri:"//nafdac.gov.ng/ontology/clause/57/12"}}, {clause_id:"Reg_57_C13", properties:{clause_text:"Individuals liable to imprisonment ≤1 year or fine ≤₦800,000 or both; corporates liable to fine ≤₦5,000,000.", regulation_version_id:"Reg_57_2021", clause_number:"13", uri:"//nafdac.gov.ng/ontology/clause/57/13"}}, {clause_id:"Reg_57_C14", properties:{clause_text:"Convicted persons shall forfeit assets or property derived from offence and instrumentalities used to commit offence.", regulation_version_id:"Reg_57_2021", clause_number:"14", uri:"//nafdac.gov.ng/ontology/clause/57/14"}}, {clause_id:"Reg_57_C15", properties:{clause_text:"Wine Regulations, 2005 revoked; actions under revoked Regulations remain valid.", regulation_version_id:"Reg_57_2021", clause_number:"15", uri:"//nafdac.gov.ng/ontology/clause/57/15"}}, {clause_id:"Reg_57_C16", properties:{clause_text:"The Agency shall be responsible for the enforcement of these Regulations.", regulation_version_id:"Reg_57_2021", clause_number:"16", uri:"//nafdac.gov.ng/ontology/clause/57/16"}}, {clause_id:"Reg_57_C17", properties:{clause_text:"Definitions provided for Agency, Cuvée, Dry wine, Flavouring, Label, Grape juice, Grape product, Grape, Grape wine, Identified crop year, Method of production, Non-grape wine, Perry, Principal display panel, Sweet reserve, Sweet wine, Varietal wine, Vintage-dated wine, Wine, Proceeds.", regulation_version_id:"Reg_57_2021", clause_number:"17", uri:"//nafdac.gov.ng/ontology/clause/57/17"}}, {clause_id:"Reg_57_C18", properties:{clause_text:"These Regulations shall be cited as Wine Regulations, 2021.", regulation_version_id:"Reg_57_2021", clause_number:"18", uri:"//nafdac.gov.ng/ontology/clause/57/18"}}] AS row
CREATE (n:Clause{clause_id: row.clause_id}) SET n += row.properties;
UNWIND [{label_id:"LA_FPA_1", properties:{product_type:"Food", context:"Advertisement", uri:"//nafdac.gov.ng/ontology/labelArtifact/LA_FPA_1", constraints:"Must not imply disease cure"}}, {label_id:"LA_Milk_Source", properties:{product_type:"Milk", context:"Labeling", uri:"//nafdac.gov.ng/ontology/labelArtifact/LA_Milk_Source", constraints:"Must declare animal source"}}] AS row
CREATE (n:LabelArtifact{label_id: row.label_id}) SET n += row.properties;
