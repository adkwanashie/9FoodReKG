UNWIND [{start: {_id:53}, end: {_id:54}, properties:{}}, {start: {_id:85}, end: {_id:86}, properties:{}}, {start: {_id:114}, end: {_id:115}, properties:{}}, {start: {_id:143}, end: {_id:144}, properties:{}}, {start: {_id:169}, end: {_id:170}, properties:{}}, {start: {_id:194}, end: {_id:195}, properties:{}}, {start: {_id:200}, end: {_id:201}, properties:{}}, {start: {_id:225}, end: {_id:226}, properties:{}}, {start: {_id:268}, end: {_id:269}, properties:{}}, {start: {_id:343}, end: {_id:344}, properties:{}}, {start: {_id:352}, end: {_id:353}, properties:{}}, {start: {_id:361}, end: {_id:362}, properties:{}}, {start: {_id:370}, end: {_id:371}, properties:{}}, {start: {_id:376}, end: {_id:377}, properties:{}}, {start: {_id:382}, end: {_id:383}, properties:{}}, {start: {_id:447}, end: {_id:448}, properties:{}}, {start: {_id:465}, end: {_id:466}, properties:{}}, {start: {_id:616}, end: {_id:617}, properties:{}}, {start: {_id:629}, end: {_id:630}, properties:{}}] AS row
