UNWIND [{schedule_item_id:"Sched_71_OrangeJuice", properties:{thresholds:"Brix ≥ 11.2", name:"Orange Juice", conditions:"Measured at 20°C", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_71_OrangeJuice", schedule_id:"Sched_71_Brix"}}, {schedule_item_id:"Sched_80_ButterFat", properties:{thresholds:"Milk fat ≥ 82%", name:"Butter", conditions:"Measured at 20°C", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_80_ButterFat", schedule_id:"Sched_80_Composition"}}, {schedule_item_id:"Sched_82_Aspartame", properties:{thresholds:"Maximum 600 mg/kg", name:"Aspartame", conditions:"Applicable to soft drinks and fruit juices", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_82_Aspartame", schedule_id:"Sched_82_Sweeteners"}}, {schedule_item_id:"Sched_85_Carbonated", properties:{thresholds:"CO₂ ≥ 2.5 volumes", name:"Carbonated Soft Drinks", conditions:"Measured at 20°C", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_85_Carbonated", schedule_id:"Sched_85_Class"}}, {schedule_item_id:"Sched_69_Class1", properties:{thresholds:"0.2 kGy", name:"Bulbs, roots, tubers (Onions, Yams, Potatoes)", conditions:"To inhibit sprouting during storage", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_69_Class1", schedule_id:"Sched_69_Foods"}}, {schedule_item_id:"Sched_68_Anticaking", properties:{thresholds:"As prescribed by Agency", name:"Anticaking Agents", conditions:"Includes carbonates, magnesium oxide, silicon dioxide, ferrocyanides", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_68_Anticaking", schedule_id:"Sched_68_Additives"}}, {schedule_item_id:"Sched_68_Arsenic", properties:{thresholds:"0.5 mg/kg", name:"Arsenic", conditions:"Expressed as As", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_68_Arsenic", schedule_id:"Sched_68_Contaminants"}}, {schedule_item_id:"Sched_27_Oils", properties:{thresholds:"Use term 'Oil' with 'vegetable' or 'animal', qualified by 'hydrogenated' or 'partially-hydrogenated'", name:"Refined oils other than olive", conditions:"As appropriate per Codex standards", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_27_Oils", schedule_id:"Sched_27_Additives"}}, {schedule_item_id:"Sched_26_PeanutOil", properties:{thresholds:"Relative density 0.909–0.920; Iodine value 77–107; Acid value ≤4mg KOH/g (virgin)", name:"Arachis Oil (Peanut Oil)", conditions:"Derived from groundnuts; composition per Second Schedule", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_26_PeanutOil", schedule_id:"Sched_26_Oils"}}, {schedule_item_id:"Sched_26_CoconutOil", properties:{thresholds:"Composition per Seventeenth Schedule", name:"Coconut Oil", conditions:"Derived from kernel of coconut (Cocos nucifera)", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_26_CoconutOil", schedule_id:"Sched_26_Oils"}}, {schedule_item_id:"Sched_26_PalmOil", properties:{thresholds:"Composition per Twelfth Schedule", name:"Palm Oil", conditions:"Derived from pulp of oil palm fruit (Elaeis guineensis)", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_26_PalmOil", schedule_id:"Sched_26_Oils"}}, {schedule_item_id:"Sched_26_OliveOil", properties:{thresholds:"Relative density 0.910–0.916; Iodine value 75–94; Acid value ≤0.6mg KOH/g (refined)", name:"Olive Oil", conditions:"Obtained from fruit of olive tree (Olea europaea)", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_26_OliveOil", schedule_id:"Sched_26_Oils"}}, {schedule_item_id:"Sched_26_SheaButter", properties:{thresholds:"Composition per Sixteenth Schedule", name:"Shea Butter", conditions:"Derived from kernels of Vitellaria paradoxa", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_26_SheaButter", schedule_id:"Sched_26_Oils"}}, {schedule_item_id:"Sched_26_Margarine", properties:{thresholds:"Fat ≥80%; Water ≤16%; Vitamin A 26,000–33,000 IU/kg; Vitamin D 28,000–33,000 IU/kg", name:"Margarine", conditions:"Product of emulsification of edible oils/fats with water or milk", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_26_Margarine", schedule_id:"Sched_26_Oils"}}, {schedule_item_id:"Sched_67_Disease_AIDS", properties:{name:"Acquired Immune Deficiency Syndrome", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_67_Disease_AIDS", schedule_id:"Sched_67_Diseases"}}, {schedule_item_id:"Sched_67_Disease_Diabetes", properties:{name:"Diabetes", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_67_Disease_Diabetes", schedule_id:"Sched_67_Diseases"}}, {schedule_item_id:"Sched_67_VitA", properties:{thresholds:"800 µg", name:"Vitamin A", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_67_VitA", schedule_id:"Sched_67_NRVs"}}, {schedule_item_id:"Sched_67_Iron", properties:{thresholds:"14 mg", name:"Iron", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_67_Iron", schedule_id:"Sched_67_NRVs"}}, {schedule_item_id:"Sched_67_SugarVitA", properties:{thresholds:"25,000 IU/kg", name:"Sugar", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_67_SugarVitA", schedule_id:"Sched_67_VitALevels"}}, {schedule_item_id:"Sched_67_VegOilVitA", properties:{thresholds:"20,000 IU/kg", name:"Vegetable Oil", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_67_VegOilVitA", schedule_id:"Sched_67_VitALevels"}}, {schedule_item_id:"Sched_67_FlourIron", properties:{thresholds:"40 mg/kg", name:"Iron", conditions:"NaFeEDTA", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_67_FlourIron", schedule_id:"Sched_67_FlourMicronutrients"}}, {schedule_item_id:"Sched_67_BreakfastCereals", properties:{name:"Breakfast Cereals", conditions:"Voluntary fortification with thiamine, niacin, vitamin B6, folic acid, pantothenic acid, magnesium, iron, zinc", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_67_BreakfastCereals", schedule_id:"Sched_67_Foods"}}, {schedule_item_id:"Sched_67_SourceClaim", properties:{name:"Source of (Vitamin/Mineral)", conditions:"≥5% NRV per 100g/100ml or per serving", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_67_SourceClaim", schedule_id:"Sched_67_Claims"}}, {schedule_item_id:"Sched_67_ExcellentClaim", properties:{name:"Excellent source of (Vitamin/Mineral)", conditions:"≥30% NRV per 100g/100ml", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_67_ExcellentClaim", schedule_id:"Sched_67_Claims"}}, {schedule_item_id:"Sched_56_Whisky", properties:{name:"Whisky", conditions:"Potable alcoholic distillate from cereal grain mash; ≥40% alcohol by volume; maturation required.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_Whisky", schedule_id:"Sched_56_Categories"}}, {schedule_item_id:"Sched_56_Rum", properties:{name:"Rum", conditions:"Produced by fermentation and distillation of molasses or sugarcane juice; ≥37.5% alcohol.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_Rum", schedule_id:"Sched_56_Categories"}}, {schedule_item_id:"Sched_56_Gin", properties:{name:"Gin", conditions:"Blend of ethyl alcohol of agricultural origin with juniper berries and botanicals; ≥37% alcohol.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_Gin", schedule_id:"Sched_56_Categories"}}, {schedule_item_id:"Sched_56_Brandy", properties:{name:"Brandy", conditions:"Distillate from fermented fruit juice or wine; ≥36% alcohol; no added ethyl alcohol.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_Brandy", schedule_id:"Sched_56_Categories"}}, {schedule_item_id:"Sched_56_Vodka", properties:{name:"Vodka", conditions:"Neutral spirit distilled from agricultural origin; charcoal treated; ≥37.5% alcohol.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_Vodka", schedule_id:"Sched_56_Categories"}}, {schedule_item_id:"Sched_56_Ethanol_Organoleptic", properties:{name:"Organoleptic Characteristics", conditions:"No detectable taste other than raw material.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_Ethanol_Organoleptic", schedule_id:"Sched_56_Ethanol"}}, {schedule_item_id:"Sched_56_Rum_Blended", properties:{name:"Blended Rum", conditions:"Blend of two or more different rum types from same category; ≥37.5% alcohol.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_Rum_Blended", schedule_id:"Sched_56_Categories"}}, {schedule_item_id:"Sched_56_DistilledGin", properties:{name:"Distilled Gin", conditions:"Obtained by re-distillation of grain or molasses spirit with juniper berries; ≥37% alcohol.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_DistilledGin", schedule_id:"Sched_56_Categories"}}, {schedule_item_id:"Sched_56_DryGin", properties:{name:"Dry Gin", conditions:"Gin to which no sugar has been added.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_DryGin", schedule_id:"Sched_56_Categories"}}, {schedule_item_id:"Sched_56_Cognac", properties:{name:"Cognac Brandy", conditions:"Manufactured in Cognac district of France; ≥36% alcohol.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_Cognac", schedule_id:"Sched_56_Categories"}}, {schedule_item_id:"Sched_56_Armagnac", properties:{name:"Armagnac Brandy", conditions:"Manufactured in Armagnac district of France; ≥36% alcohol.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_Armagnac", schedule_id:"Sched_56_Categories"}}, {schedule_item_id:"Sched_56_FruitBrandy", properties:{name:"Fruit Brandy", conditions:"Distillate from fruit wine or mash; labelled by fruit name; ≥36% alcohol.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_FruitBrandy", schedule_id:"Sched_56_Categories"}}, {schedule_item_id:"Sched_56_Liqueur", properties:{name:"Liqueur", conditions:"Spirit drink sweetened with ≥2.5% sugar; ≥15% alcohol; may contain flavourings.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_Liqueur", schedule_id:"Sched_56_Categories"}}, {schedule_item_id:"Sched_56_Sambuca", properties:{name:"Sambuca", conditions:"Colourless aniseed-flavoured liqueur; ≥38% alcohol; ≥350g sugar per litre.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_Sambuca", schedule_id:"Sched_56_Categories"}}, {schedule_item_id:"Sched_56_Tequila", properties:{name:"Tequila", conditions:"Distillate from Agave tequilana weber (blue variety); manufactured per Mexican law.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_Tequila", schedule_id:"Sched_56_Categories"}}, {schedule_item_id:"Sched_56_Gentian", properties:{name:"Gentian", conditions:"Produced from distillate of gentian roots; ≥37.5% alcohol; not flavoured.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_Gentian", schedule_id:"Sched_56_Categories"}}, {schedule_item_id:"Sched_56_Juniper", properties:{name:"Juniper-flavoured Spirit Drink", conditions:"Flavoured with juniper berries; ≥30% alcohol.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_Juniper", schedule_id:"Sched_56_Categories"}}, {schedule_item_id:"Sched_56_Caraway", properties:{name:"Caraway-flavoured Spirit Drink", conditions:"Flavoured with caraway; ≥30% alcohol.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_Caraway", schedule_id:"Sched_56_Categories"}}, {schedule_item_id:"Sched_56_Aniseed", properties:{name:"Aniseed-flavoured Spirit Drink", conditions:"Flavoured with anise, star anise, fennel; ≥15% alcohol.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_Aniseed", schedule_id:"Sched_56_Categories"}}, {schedule_item_id:"Sched_56_Pastis", properties:{name:"Pastis", conditions:"Aniseed-flavoured spirit with liquorice root extracts; 0.05–0.5g glycyrrhizic acid per litre; ≥40% alcohol.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_Pastis", schedule_id:"Sched_56_Categories"}}, {schedule_item_id:"Sched_56_Anis", properties:{name:"Anis", conditions:"Aniseed-flavoured spirit drink; ≥35% alcohol; distilled anis must contain ≥20% distilled alcohol.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_Anis", schedule_id:"Sched_56_Categories"}}, {schedule_item_id:"Sched_56_Bitters", properties:{name:"Bitters", conditions:"Predominantly bitter taste; flavoured with botanicals; ≥15% alcohol.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_Bitters", schedule_id:"Sched_56_Categories"}}, {schedule_item_id:"Sched_56_WineSpirit", properties:{name:"Wine Spirit", conditions:"Produced exclusively by distillation of wine or wine distillate at <86% vol.; volatile substances ≥125g/hL; methanol ≤200g/hL; ≥37.5% alcohol; may contain caramel for colour.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_WineSpirit", schedule_id:"Sched_56_Categories"}}, {schedule_item_id:"Sched_56_PomaceMarc", properties:{name:"Pomace or Marc", conditions:"Distillate from skin and pulp of ripe fruit after juice removal.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_PomaceMarc", schedule_id:"Sched_56_Categories"}}, {schedule_item_id:"Sched_56_CremeDe", properties:{name:"Crème de (Fruit)", conditions:"Liqueur with ≥250g sugar per litre; ≥15% alcohol.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_CremeDe", schedule_id:"Sched_56_Categories"}}, {schedule_item_id:"Sched_56_CremeDeCassis", properties:{name:"Crème de Cassis", conditions:"Blackcurrant liqueur; ≥400g sugar per litre; ≥15% alcohol.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_CremeDeCassis", schedule_id:"Sched_56_Categories"}}, {schedule_item_id:"Sched_56_SloeGin", properties:{name:"Sloe Gin", conditions:"Liqueur from maceration of sloes in gin; ≥25% alcohol.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_SloeGin", schedule_id:"Sched_56_Categories"}}, {schedule_item_id:"Sched_56_Maraschino", properties:{name:"Maraschino", conditions:"Colourless cherry liqueur; ≥24% alcohol; ≥250g sugar per litre.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_Maraschino", schedule_id:"Sched_56_Categories"}}, {schedule_item_id:"Sched_56_Nocino", properties:{name:"Nocino", conditions:"Walnut liqueur; ≥30% alcohol; ≥100g sugar per litre.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_Nocino", schedule_id:"Sched_56_Categories"}}, {schedule_item_id:"Sched_56_EggLiqueur", properties:{name:"Egg Liqueur (Advocaat)", conditions:"Contains egg yolk, egg white, sugar/honey; ≥14% alcohol; ≥150g sugar per litre.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_EggLiqueur", schedule_id:"Sched_56_Categories"}}, {schedule_item_id:"Sched_56_HoneyMead", properties:{name:"Honey or Mead Nectar", conditions:"Produced from fermented honey mash; ≥22% alcohol.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_HoneyMead", schedule_id:"Sched_56_Categories"}}, {schedule_item_id:"Sched_56_FlavouredSpirit", properties:{name:"Flavoured Spirit Drink", conditions:"Ethyl alcohol of agricultural origin with added flavours; ≥30% alcohol.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_FlavouredSpirit", schedule_id:"Sched_56_Categories"}}, {schedule_item_id:"Sched_56_Ethanol_Purity", properties:{name:"Purity", conditions:"Must meet Agency standards for ethanol of agricultural origin.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_Ethanol_Purity", schedule_id:"Sched_56_Ethanol"}}, {schedule_item_id:"Sched_56_Additives_List", properties:{name:"Food Additives", conditions:"Use and limits as prescribed by the Agency.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_Additives_List", schedule_id:"Sched_56_Additives"}}, {schedule_item_id:"Sched_56_Contaminants_List", properties:{name:"Contaminants", conditions:"Levels must comply with Agency standards.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_Contaminants_List", schedule_id:"Sched_56_Contaminants"}}, {schedule_item_id:"Sched_56_Colours_List", properties:{name:"Food Colours", conditions:"Use and limits as prescribed by the Agency.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_56_Colours_List", schedule_id:"Sched_56_Colours"}}, {schedule_item_id:"Sched_57_BlancDeNoirs", properties:{name:"Blanc de noirs wine", conditions:"Produced exclusively from ≥85% red grapes; juice separated before fermentation; vinified as white wine.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_57_BlancDeNoirs", schedule_id:"Sched_57_WineCategories"}}, {schedule_item_id:"Sched_57_BlancDeBlanc", properties:{name:"Blanc de blanc wine", conditions:"Produced exclusively from ≥85% white grapes; vinified as white wine.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_57_BlancDeBlanc", schedule_id:"Sched_57_WineCategories"}}, {schedule_item_id:"Sched_57_Botrytized", properties:{name:"Botrytized wine", conditions:"Produced from grapes affected by Botrytis cinerea; juice ≥34°Brix.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_57_Botrytized", schedule_id:"Sched_57_WineCategories"}}, {schedule_item_id:"Sched_57_Cider", properties:{name:"Cider", conditions:"Fermentation of apple juice or apple/pear mix; ≤25% pear juice; 2.5–13% alcohol.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_57_Cider", schedule_id:"Sched_57_WineCategories"}}, {schedule_item_id:"Sched_57_FortifiedWine", properties:{name:"Fortified wine", conditions:"Wine with distilled spirits added; 14–24% alcohol.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_57_FortifiedWine", schedule_id:"Sched_57_WineCategories"}}, {schedule_item_id:"Sched_57_FruitWine", properties:{name:"Fruit wine", conditions:"Fermentation of juice of sound ripe fruits; must meet wine standards.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_57_FruitWine", schedule_id:"Sched_57_WineCategories"}}, {schedule_item_id:"Sched_57_SparklingWine", properties:{name:"Sparkling wine", conditions:"Secondary fermentation in bottle; 14–21% alcohol.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_57_SparklingWine", schedule_id:"Sched_57_WineCategories"}}, {schedule_item_id:"Sched_57_TableWine", properties:{name:"Table wine", conditions:"6–17% alcohol; 5–8.5% from natural sugar; grapes ≥15°Brix.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_57_TableWine", schedule_id:"Sched_57_WineCategories"}}, {schedule_item_id:"Sched_57_Vermouth", properties:{name:"Vermouth", conditions:"Wine with bitters, aromatics, or botanical flavourings; ≤20% alcohol.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_57_Vermouth", schedule_id:"Sched_57_WineCategories"}}, {schedule_item_id:"Sched_57_WineSpirit", properties:{name:"Wine spirit", conditions:"Distillation of wine at <86% vol.; volatile substances ≥125g/hL; methanol ≤200g/hL; ≥37.5% alcohol; may contain caramel.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_57_WineSpirit", schedule_id:"Sched_57_WineCategories"}}, {schedule_item_id:"Sched_57_Dry", properties:{name:"Dry", conditions:"≤4 g/L glucose+fructose, or ≤9 g/L if acidity ≥2 g/L.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_57_Dry", schedule_id:"Sched_57_Sweetness"}}, {schedule_item_id:"Sched_57_MediumDry", properties:{name:"Medium dry", conditions:"≤12 g/L glucose+fructose, or ≤18 g/L if acidity threshold met.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_57_MediumDry", schedule_id:"Sched_57_Sweetness"}}, {schedule_item_id:"Sched_57_Mellow", properties:{name:"Mellow or semi-sweet", conditions:"≤45 g/L glucose+fructose.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_57_Mellow", schedule_id:"Sched_57_Sweetness"}}, {schedule_item_id:"Sched_57_Sweet", properties:{name:"Sweet", conditions:"≥45 g/L glucose+fructose.", uri:"//nafdac.gov.ng/ontology/scheduleItem/Sched_57_Sweet", schedule_id:"Sched_57_Sweetness"}}] AS row
CREATE (n:ScheduleItem{schedule_item_id: row.schedule_item_id}) SET n += row.properties;
UNWIND [{_id:300, properties:{heading:"Scope of application", regulation_version_id:"Reg_67_2021", section_no:1, text:"These Regulations apply to all fortified foods manufactured, imported, exported, distributed, advertised, sold or used in Nigeria."}}, {_id:303, properties:{heading:"Prohibition", regulation_version_id:"Reg_67_2021", section_no:2, text:"(a) No person shall sell or advertise any food represented as fortified unless registered with the Agency; (b) Fortified foods shall not be represented as treatment, preventive or curative for diseases listed in First Schedule; (c) Fortification shall not cause intake to exceed NRVs in Second Schedule; (d) Foods in Fourth Schedule must be mandatorily fortified with Vitamin A as prescribed."}}, {_id:306, properties:{heading:"Advertisement of foods to which no Vitamin or Mineral has been added", regulation_version_id:"Reg_67_2021", section_no:3, text:"Claims 'source', 'good source', or 'excellent source' may be made only where intake meets thresholds specified in Second Schedule."}}, {_id:309, properties:{heading:"Label declaration of food to which Vitamin or mineral has been added", regulation_version_id:"Reg_67_2021", section_no:4, text:"Amounts of added vitamins/minerals must be declared; only declare when ≥5% NRV per serving; claims at ≥15% NRV per serving per Sixth Schedule."}}, {_id:312, properties:{heading:"Statement relating to mineral content of food", regulation_version_id:"Reg_67_2021", section_no:5, text:"Calcium/phosphorus: factor in normal development and maintenance of bones and teeth; calcium/phosphorus/iron: factor in maintenance of good health."}}, {_id:315, properties:{heading:"Label declaration of food mandatorily fortified with Vitamin A", regulation_version_id:"Reg_67_2021", section_no:6, text:"Vitamin A amount must be declared per label; mandatory fortification levels per Third Schedule; flour micronutrients per Fourth Schedule."}}, {_id:318, properties:{heading:"Labelling", regulation_version_id:"Reg_67_2021", section_no:7, text:"Declare % daily value of added vitamin/mineral; products in Second Schedule shall carry an eye symbol with 'A' for Vitamin A fortification."}}, {_id:321, properties:{heading:"Packaging", regulation_version_id:"Reg_67_2021", section_no:8, text:"Fortified foods shall be packaged to safeguard hygienic, nutritional, organoleptic qualities; materials must be safe and suitable; consider fortificant effects on shelf life."}}, {_id:324, properties:{heading:"Offences and Penalties", regulation_version_id:"Reg_67_2021", section_no:9, text:"Individual: up to 1 year imprisonment or fine ≤ ₦800,000 or both; body corporate: fine ≤ ₦5,000,000; officers liable unless lack of knowledge/consent/connivance proven."}}, {_id:327, properties:{heading:"Forfeiture after conviction", regulation_version_id:"Reg_67_2021", section_no:10, text:"Forfeit proceeds and instrumentalities used to commit or facilitate the offence."}}, {_id:330, properties:{heading:"Revocation", regulation_version_id:"Reg_67_2021", section_no:11, text:"Food Fortification Regulations 2005 and Vitamin A Fortification Regulations 2005 are revoked; actions under revoked regulations preserved."}}, {_id:333, properties:{heading:"Enforcement", regulation_version_id:"Reg_67_2021", section_no:12, text:"The Agency shall be responsible for enforcement of these Regulations."}}, {_id:336, properties:{heading:"Interpretation", regulation_version_id:"Reg_67_2021", section_no:13, text:"Definitions for Advertising, Advertisement, Agency, Food, Fortificant, Fortification, Fortified Foods, Global Listing, Logo, Micronutrient, Mineral Nutrient, NRV, Proceeds, Testimonial, Vitamin, Vitamin A."}}, {_id:339, properties:{heading:"Citation", regulation_version_id:"Reg_67_2021", section_no:14, text:"These Regulations may be cited as Food Fortification Regulations, 2021."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Section;
